# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only — required for account deletion (auth.admin.deleteUser). Never expose as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App URL (for email redirect links in password reset and OAuth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Internal support destination. Keep this server-only and swap to support@yourdomain.com later.
SUPPORT_EMAIL="aryanandshrestha@gmail.com"
# Official in-app Motivo support account identity. Users see this account as "Motivo".
MOTIVO_SUPPORT_ACCOUNT_EMAIL="aryanandshrestha@gmail.com"

# Resend (https://resend.com) — transactional email for the /help support form.
# Create an API key at https://resend.com/api-keys and paste it here.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified-domain sender. Defaults to Resend's shared "onboarding@resend.dev",
# which only delivers to the email that owns your Resend account. To send to any
# address, verify a domain at https://resend.com/domains and set this to e.g.
# "Motivo Support <support@yourdomain.com>".
SUPPORT_FROM_EMAIL="Motivo Support <onboarding@resend.dev>"

# Geoapify Address Autocomplete API. Server-only key used for city autocomplete.
GEOAPIFY_API_KEY="your_key_here"

ADMIN_EMAILS="your-email@example.com,another-admin@example.com"
