# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only — required for account deletion (auth.admin.deleteUser). Never expose as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App URL (for email redirect links in password reset and OAuth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Internal support destination. Keep this server-only and swap to support@yourdomain.com later.
SUPPORT_EMAIL="aryanandshrestha@gmail.com"
