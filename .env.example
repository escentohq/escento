# Database (Supabase Postgres — same project as auth, or separate URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Demo mode (set to "true" to show fake users in listings, "false" or omit to hide)
NEXT_PUBLIC_DEMO_MODE="false"
